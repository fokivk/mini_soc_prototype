# HTTP Attack Detection Rules
alert http any any -> any $HTTP_PORTS (msg:"HTTP Attack - Directory Traversal"; content:"../"; nocase; sid:1000024; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"HTTP Attack - Command Injection"; content:"%7c"; sid:1000025; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"HTTP Attack - Command Injection"; content:"%60"; sid:1000026; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"HTTP Attack - Command Injection"; content:"%24%28"; sid:1000027; rev:1;)


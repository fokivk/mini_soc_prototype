# High Priority HTTP Attack Rules
alert http any any -> any $HTTP_PORTS (msg:"CRITICAL - XSS Attack Detected"; content:"<script"; nocase; sid:1000037; rev:1; priority:1;)

alert http any any -> any $HTTP_PORTS (msg:"CRITICAL - SQL Injection Detected"; content:"UNION SELECT"; nocase; sid:1000038; rev:1; priority:1;)

alert http any any -> any $HTTP_PORTS (msg:"CRITICAL - Command Injection Detected"; content:"%7c"; sid:1000039; rev:1; priority:1;)


# Mini SOC Custom Rules
# XSS Detection Rules
alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - Script Tag"; content:"<script"; nocase; sid:1000001; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - JavaScript"; content:"javascript:"; nocase; sid:1000002; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - OnLoad Event"; content:"onload="; nocase; sid:1000003; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - OnClick Event"; content:"onclick="; nocase; sid:1000004; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - IMG Tag"; content:"<img"; nocase; sid:1000018; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - Body Tag"; content:"<body"; nocase; sid:1000019; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"XSS Attack - Alert Function"; content:"alert("; nocase; sid:1000020; rev:1;)

# SQL Injection Detection Rules
alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - UNION SELECT"; content:"UNION SELECT"; nocase; sid:1000005; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - OR 1=1"; content:"OR 1=1"; nocase; sid:1000006; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - DROP TABLE"; content:"DROP TABLE"; nocase; sid:1000007; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - INSERT INTO"; content:"INSERT INTO"; nocase; sid:1000008; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - DELETE FROM"; content:"DELETE FROM"; nocase; sid:1000009; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - UPDATE SET"; content:"UPDATE SET"; nocase; sid:1000010; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - Single Quote"; content:"%27"; sid:1000021; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - Comment"; content:"--"; sid:1000022; rev:1;)

alert http any any -> any $HTTP_PORTS (msg:"SQL Injection - Semicolon"; content:"%3b"; sid:1000023; rev:1;)

# Port Scan Detection Rules - DISABLED
# alert tcp any any -> any any (msg:"Port Scan - TCP SYN Scan"; flow:stateless; flags:S,12; threshold:type threshold, track by_src, count 20, seconds 60; sid:1000011; rev:2;)

# alert tcp any any -> any any (msg:"Port Scan - TCP Connect Scan"; flow:established; flags:S; threshold:type threshold, track by_src, count 30, seconds 60; sid:1000012; rev:2;)

# alert tcp any any -> any any (msg:"Port Scan - TCP FIN Scan"; flow:stateless; flags:F,12; threshold:type threshold, track by_src, count 20, seconds 60; sid:1000013; rev:2;)

